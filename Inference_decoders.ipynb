      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Created Gaussian mask with shape: torch.Size([720, 1440])\n",
            "Max perturbation amplitude: 2.488 K\n",
            "Perturbation affects 35509 grid points significantly (>0.01K)\n"
          ]
        }
      ],
      "source": [
        "def create_gaussian_perturbation_mask(lat_array, lon_array, center_lat, center_lon, sigma, amplitude):\n",
        "    \"\"\"\n",
        "    Create a 2D Gaussian perturbation mask\n",
        "\n",
        "    Parameters:\n",
        "    - lat_array, lon_array: coordinate arrays from the batch metadata\n",
        "    - center_lat, center_lon: center of the perturbation\n",
        "    - sigma: standard deviation of the Gaussian (degrees)\n",
        "    - amplitude: maximum amplitude of the perturbation\n",
        "\n",
        "    Returns:\n",
        "    - torch.Tensor: 2D perturbation mask [H, W]\n",
        "    \"\"\"\n",
        "    # Handle longitude wrapping (ERA5 data uses 0-360° convention)\n",
        "    center_lon_adj = center_lon\n",
        "    if lon_array.max() > 180:\n",
        "        center_lon_adj = center_lon % 360\n",
        "\n",
        "    # Create meshgrid\n",
        "    LON, LAT = np.meshgrid(lon_array, lat_array)\n",
        "\n",
        "    # Calculate distances\n",
        "    dlon = LON - center_lon_adj\n",
        "    dlat = LAT - center_lat\n",
        "\n",
        "    # Handle longitude wrapping for distance calculation\n",
        "    dlon = np.where(dlon > 180, dlon - 360, dlon)\n",
        "    dlon = np.where(dlon < -180, dlon + 360, dlon)\n",
        "\n",
        "    # Create Gaussian mask\n",
        "    gaussian_mask = amplitude * np.exp(-(dlon**2 + dlat**2) / (2 * sigma**2))\n",
        "\n",
        "    return torch.from_numpy(gaussian_mask).float()\n",
        "\n",
        "# Test the function with our batch data\n",
        "lat_array = batch.metadata.lat.numpy()\n",
        "lon_array = batch.metadata.lon.numpy()\n",
        "\n",
        "gaussian_mask = create_gaussian_perturbation_mask(\n",
        "    lat_array, lon_array, center_lat, center_lon, sigma, delta_T\n",
        ")\n",
        "\n",
        "print(f\"Created Gaussian mask with shape: {gaussian_mask.shape}\")\n",
        "print(f\"Max perturbation amplitude: {gaussian_mask.max().item():.3f} K\")\n",
        "print(f\"Perturbation affects {(gaussian_mask > 0.01).sum()} grid points significantly (>0.01K)\")"
      ]
    },
