        "from aurora.rollout import rollout\n",
        "\n",
        "# Perform a 4-step rollout (24 hours of predictions, 6-hour steps)\n",
        "rollout_steps = 4\n",
        "rollout_predictions = []\n",
        "rollout_decoder_predictions = []\n",
        "\n",
        "with torch.inference_mode():\n",
        "    for i, pred_batch in enumerate(rollout(modelAurora, batch, rollout_steps)):\n",
        "        print(f\"Step {i+1}/{rollout_steps}: Predicting for {pred_batch.metadata.time[0]}\")\n",
        "\n",
        "        # Store Aurora predictions\n",
        "        rollout_predictions.append(pred_batch)\n",
        "\n",
        "        # Get decoder predictions for this timestep\n",
        "        _, lat_dec = modelAurora.forward(pred_batch)\n",
        "        latent_decoder = lat_dec.detach().clone()\n",
        "        decoder_preds = modelDecoder.forward(latent_decoder, pred_batch.metadata.lat, pred_batch.metadata.lon)\n",
        "\n",
        "        # Transform decoder predictions back to original scale\n",
        "        decoder_preds_transformed = {k: transform_data(v.cpu().numpy().squeeze(), k, direct=False)\n",
        "                                   for k, v in decoder_preds.items()}\n",
        "        rollout_decoder_predictions.append(decoder_preds_transformed)\n",
        "\n",
        "print(f\"Rollout complete! Generated {len(rollout_predictions)} predictions.\")"
      ]
    },
