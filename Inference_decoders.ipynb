      "source": [
        "def shift_longitude_for_pacific_center(data_array, lon_array):\n",
        "    \"\"\"\n",
        "    Shift longitude coordinates and data to center at 180° (Pacific-centered view)\n",
        "\n",
        "    Parameters:\n",
        "    - data_array: 2D array with shape (lat, lon)\n",
        "    - lon_array: longitude coordinates (0-360°)\n",
        "\n",
        "    Returns:\n",
        "    - shifted_data: data array shifted for Pacific centering\n",
        "    - shifted_lons: longitude array shifted to -180 to 180° range\n",
        "    \"\"\"\n",
        "    # Convert longitude from 0-360° to -180 to 180°\n",
        "    shifted_lons = np.where(lon_array <= 180, lon_array, lon_array - 360)\n",
        "\n",
        "    # Find the split point (where longitude changes from positive to negative)\n",
        "    split_idx = np.where(lon_array > 180)[0][0] if np.any(lon_array > 180) else len(lon_array)\n",
        "\n",
        "    # Shift the data array to match the new longitude ordering\n",
        "    shifted_data = np.concatenate([data_array[:, split_idx:], data_array[:, :split_idx]], axis=1)\n",
        "\n",
        "    # Sort both arrays by longitude for proper plotting\n",
        "    sort_idx = np.argsort(shifted_lons)\n",
        "    shifted_lons_sorted = shifted_lons[sort_idx]\n",
        "    shifted_data_sorted = shifted_data[:, sort_idx]\n",
        "\n",
        "    return shifted_data_sorted, shifted_lons_sorted\n",
        "\n",
        "# Test the function with our current data\n",
        "lon_array = batch.metadata.lon.numpy()\n",
        "lat_array = batch.metadata.lat.numpy()\n",
        "\n",
        "print(f\"Original longitude range: {lon_array.min():.1f}° to {lon_array.max():.1f}°\")\n",
        "\n",
        "# Test with a sample array\n",
        "test_data = np.random.rand(len(lat_array), len(lon_array))\n",
        "shifted_test, shifted_lons = shift_longitude_for_pacific_center(test_data, lon_array)\n",
        "\n",
        "print(f\"Shifted longitude range: {shifted_lons.min():.1f}° to {shifted_lons.max():.1f}°\")\n",
        "print(f\"Data shape: original {test_data.shape}, shifted {shifted_test.shape}\")\n",
        "print(f\"Pacific-centered extent will be: ({shifted_lons.min():.0f}, {shifted_lons.max():.0f}, -90, 90)\")"
      ]
    },
