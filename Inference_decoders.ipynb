    "rms_changes = np.array(rms_changes)\n",
    "max_absolute_changes = np.array(max_absolute_changes)\n",
    "total_baseline_precip = np.array(total_baseline_precip)\n",
    "total_perturbed_precip = np.array(total_perturbed_precip)\n",
    "relative_changes = np.array(relative_changes)\n",
    "\n",
    "print(f\"Time series analysis completed!\")\n",
    "print(f\"Maximum RMS change: {np.max(rms_changes)*1e3:.4f} mm/6h at T+{time_steps[np.argmax(rms_changes)]}h\")\n",
    "print(f\"Maximum absolute change: {np.max(max_absolute_changes)*1e3:.4f} mm/6h at T+{time_steps[np.argmax(max_absolute_changes)]}h\")\n",
