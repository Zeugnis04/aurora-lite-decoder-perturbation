        "print(\"1. Running baseline rollout (28 steps)...\")\n",
        "with torch.inference_mode():\n",
        "    preds_baseline_rollout = []\n",
        "    decoder_preds_baseline_rollout = []\n",
        "\n",
        "    for i, pred_batch in enumerate(rollout(modelAurora, batch_baseline, rollout_steps)):\n",
        "        print(f\"   Step {i+1}/{rollout_steps}: {pred_batch.metadata.time[0]}\")\n",
        "\n",
        "        # Store Aurora prediction\n",
        "        preds_baseline_rollout.append(pred_batch)\n",
        "\n",
        "        # Get decoder predictions\n",
        "        _, lat_dec = modelAurora.forward(pred_batch)\n",
        "        latent_decoder = lat_dec.detach().clone()\n",
        "        decoder_preds = modelDecoder.forward(latent_decoder,\n",
