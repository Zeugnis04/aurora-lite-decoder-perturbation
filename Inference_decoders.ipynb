      "source": [
        "# Analyze time series of precipitation changes\n",
        "print(\"Analyzing 28-step precipitation time series...\")\n",
        "\n",
        "# Initialize arrays for time series analysis\n",
        "time_steps = np.arange(1, rollout_steps + 1) * 6  # Convert to hours\n",
        "precipitation_changes = []\n",
        "rms_changes = []\n",
        "max_absolute_changes = []\n",
        "total_baseline_precip = []\n",
        "total_perturbed_precip = []\n",
        "relative_changes = []\n",
        "\n",
        "# Calculate statistics for each time step\n",
        "for step in range(rollout_steps):\n",
        "    precip_baseline = decoder_preds_baseline_rollout[step]['tp_mswep']\n",
        "    precip_perturbed = decoder_preds_perturbed_rollout[step]['tp_mswep']\n",
        "\n",
        "    # Calculate difference\n",
        "    precip_diff = precip_perturbed - precip_baseline\n",
        "\n",
        "    # Store statistics\n",
        "    precipitation_changes.append(precip_diff)\n",
        "    rms_changes.append(np.sqrt(np.mean(precip_diff**2)))\n",
        "    max_absolute_changes.append(np.max(np.abs(precip_diff)))\n",
        "    total_baseline_precip.append(np.sum(precip_baseline))\n",
        "    total_perturbed_precip.append(np.sum(precip_perturbed))\n",
        "\n",
        "    # Calculate relative change (avoid division by very small numbers)\n",
        "    if np.sum(precip_baseline) > 1e-10:\n",
        "        rel_change = (np.sum(precip_perturbed) - np.sum(precip_baseline)) / np.sum(precip_baseline) * 100\n",
        "    else:\n",
        "        rel_change = 0\n",
        "    relative_changes.append(rel_change)\n",
        "\n",
        "# Convert to numpy arrays\n",
        "precipitation_changes = np.array(precipitation_changes)\n",
        "rms_changes = np.array(rms_changes)\n",
        "max_absolute_changes = np.array(max_absolute_changes)\n",
        "total_baseline_precip = np.array(total_baseline_precip)\n",
        "total_perturbed_precip = np.array(total_perturbed_precip)\n",
        "relative_changes = np.array(relative_changes)\n",
        "\n",
        "print(f\"Time series analysis completed!\")\n",
        "print(f\"Maximum RMS change: {np.max(rms_changes)*1e3:.4f} mm/6h at T+{time_steps[np.argmax(rms_changes)]}h\")\n",
        "print(f\"Maximum absolute change: {np.max(max_absolute_changes)*1e3:.4f} mm/6h at T+{time_steps[np.argmax(max_absolute_changes)]}h\")\n",
        "print(f\"Maximum relative change: {np.max(np.abs(relative_changes)):.2f}% at T+{time_steps[np.argmax(np.abs(relative_changes))]}h\")"
