        "# Find indices for perturbation pressure levels\n",
        "p_levels = torch.tensor(batch_baseline.metadata.atmos_levels)\n",
        "perturb_indices = []\n",
        "\n",
        "for level in perturb_levels:\n",
        "    try:\n",
        "        idx = torch.where(p_levels == level)[0][0].item()\n",
        "        perturb_indices.append(idx)\n",
        "        print(f\"Found pressure level {level} hPa at index {idx}\")\n",
        "    except IndexError:\n",
