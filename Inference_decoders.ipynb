            "  Pressure levels: [700, 850, 925] hPa\n"
          ]
        }
      ],
      "source": [
        "# Perturbation Parameters (from PerturbationTries.ipynb methodology)\n",
        "Lv = 2.5e6       # Latent heat of vaporization [J/kg]\n",
        "cp = 1005        # Specific heat at constant pressure [J/kg·K]\n",
        "delta_q = 0.0010 # Specific humidity perturbation\n",
        "delta_T = (Lv * delta_q) / cp  # Temperature perturbation amplitude\n",
        "sigma = 8.0      # Gaussian spread parameter (degrees)\n",
        "\n",
        "# Perturbation location (can be adjusted)\n",
        "center_lat = 45  # Latitude of perturbation center\n",
        "center_lon = -147.0  # Longitude of perturbation center (Alaska region)\n",
        "\n",
        "# Pressure levels to apply perturbation (hPa)\n",
        "perturb_levels = [700, 850, 925]\n",
        "\n",
        "print(f\"Perturbation Parameters:\")\n",
        "print(f\"  Temperature amplitude: {delta_T:.3f} K\")\n",
        "print(f\"  Gaussian sigma: {sigma}°\")\n",
        "print(f\"  Center location: ({center_lat}, {center_lon})\")\n",
        "print(f\"  Pressure levels: {perturb_levels} hPa\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "zthj93snrhn",
      "metadata": {
